<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jiaqiz</groupId>
    <artifactId>learn-flink-spark</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>learn-flink-spark</name>
    <description>Flink / Spark 源码研读与实战学习工程</description>

    <modules>
        <module>learn-flink</module>
        <module>learn-spark</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 编译目标：Flink 1.20 官方推荐 Java 11；Spark 3.5 同样支持 Java 11 -->
        <maven.compiler.release>11</maven.compiler.release>

        <!-- 依赖版本集中管理 -->
        <flink.version>1.20.4</flink.version>
        <spark.version>3.5.8</spark.version>
        <scala.binary.version>2.12</scala.binary.version>

        <!-- 连接器：官方外部连接器的版本号带 Flink 后缀（这里与 flink.version 配套） -->
        <flink.connector.kafka.version>3.3.0-1.20</flink.connector.kafka.version>
        <flink.connector.jdbc.version>3.3.0-1.20</flink.connector.jdbc.version>
        <!--
          flink-connector-base：FileSink/KafkaSource 等连接器的公共基类。
          注意 flink-connector-kafka 的 pom 把它声明为 provided，不会被传递进来，
          但 KafkaSink 的 DeliveryGuarantee 枚举就在这个 jar 里，所以必须显式声明。
          本机 m2 只缓存到 1.20.3（无 1.20.4），此处用 1.20.3：该 jar 只被用来
          提供 DeliveryGuarantee 等纯 API 类型，与 1.20.4 的 flink-core 兼容。
        -->
        <flink.connector.base.version>1.20.3</flink.connector.base.version>
        <!-- 嵌入式数据库驱动：让 JDBC source/sink 演示无需外部 MySQL 即可真跑 -->
        <sqlite.version>3.44.0.0</sqlite.version>

        <!-- 日志：Flink 走 log4j2，Spark 走 log4j2 + slf4j 2.x -->
        <log4j2.version>2.24.3</log4j2.version>
        <slf4j.version>1.7.36</slf4j.version>
        <slf4j2.version>2.0.7</slf4j2.version>
        <reload4j.version>1.2.22</reload4j.version>

        <junit.version>5.10.1</junit.version>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <exec.plugin.version>3.2.0</exec.plugin.version>
        <surefire.plugin.version>3.2.5</surefire.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ==================== Apache Flink ==================== -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-streaming-java</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-clients</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-core</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-runtime</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-table-api-java</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-datagen</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-kafka</artifactId>
                <version>${flink.connector.kafka.version}</version>
            </dependency>
            <!--
              文件连接器：org.apache.flink.connector.file.sink.FileSink 在这里
              （flink-file-sink-common 只有 bucket/rolling policy 等公共部分，没有 FileSink 本体）。
            -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-files</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-base</artifactId>
                <version>${flink.connector.base.version}</version>
            </dependency>
            <!--
              JDBC 连接器：Flink 1.20 对应 3.3.0-1.20，但本机 Maven 无外网、仓库里只有
              3.1.1-1.17，因此【暂不纳入默认构建】，只在文档里给用法与坐标。
              联网后取消下面注释即可用官方连接器替换自写的 JdbcSink/JdbcSource：
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-jdbc</artifactId>
                <version>${flink.connector.jdbc.version}</version>
            </dependency>
            -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>

            <!-- ==================== Apache Spark ==================== -->
            <dependency>
                <groupId>org.apache.spark</groupId>
                <artifactId>spark-core_${scala.binary.version}</artifactId>
                <version>${spark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.spark</groupId>
                <artifactId>spark-sql_${scala.binary.version}</artifactId>
                <version>${spark.version}</version>
            </dependency>

            <!-- ==================== 测试 ==================== -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
