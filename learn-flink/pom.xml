<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jiaqiz</groupId>
        <artifactId>learn-flink-spark</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>learn-flink</artifactId>
    <name>learn-flink</name>
    <description>Apache Flink 源码研读与实战</description>

    <properties>
        <main.class>com.jiaqiz.flink.sample.WordCountJob</main.class>
    </properties>

    <dependencies>
        <!--
          说明：生产环境通常把 flink-streaming-java / flink-clients 设为 provided
          （集群自带），这里为了本地直接 run 而使用默认 compile 作用域。
        -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
        </dependency>

        <!--
          连接器：Kafka 走官方连接器（与 Flink 1.20 配套的 3.3.0-1.20，本机 m2 已缓存）。
          注意：没有 Kafka broker 时只做编译验证，运行需要外部集群。
        -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
        </dependency>

        <!--
          文件连接器：CustomSinkDemo 里演示内置 FileSink 需要它（本机 m2 已缓存 1.20.4）。
        -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-files</artifactId>
        </dependency>

        <!--
          flink-connector-base：KafkaSink 的 setDeliveryGuarantee(...) 用的是
          org.apache.flink.connector.base.DeliveryGuarantee。flink-connector-kafka 把它
          声明为 provided（不会传递进来），所以这里显式引入；本机 m2 缓存的是 1.20.3，
          该 jar 在本工程里只提供 DeliveryGuarantee 这类纯 API 类型。
        -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
        </dependency>

        <!--
          SQLite 驱动：用于「自写 JDBC Source / Sink」演示。
          选它是因为嵌入式、零部署，能让 JDBC 相关 demo 在本地真实跑通；
          官方 flink-connector-jdbc 的用法见文档（本机无外网，未纳入构建）。
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <!-- 日志：Flink 1.20 使用 log4j2 + slf4j 1.7 绑定 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Flink 本地执行会自建 FlinkUserCodeClassLoader 做 child-first 加载，
              而 exec:java 是跑在 Maven 自己的 JVM / 插件类加载器里的，会导致
              ClassNotFoundException（如 org.apache.flink.api.common.ExecutionConfig）。
              因此这里配置 exec:exec，派生一个独立的真实 JVM。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath />
                        <argument>${main.class}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
