        <mxCell id="c3-note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fffbea;strokeColor=#d6b656;" value="&lt;b&gt;三处断链刚好演示三条规则：&lt;/b&gt;&lt;br&gt;① source→flatmap：并行度不同（1≠2）&lt;br&gt;② flatmap→sum：非 ForwardPartitioner&lt;br&gt;③ sum→sink：并行度相同 + Forward ✔ 合并&lt;br&gt;&lt;br&gt;max并行度 = -1（未设置）&lt;br&gt;JobVertexID = 算子 hash" vertex="1">
