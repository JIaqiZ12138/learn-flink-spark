        <mxCell id="je0" edge="1" parent="1" source="jg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" target="jg2" value="JobEdge&lt;br&gt;（IntermediateDataSet）">
