        <mxCell id="C4-title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontStyle=1" value="④ ExecutionGraph（执行图 · JobManager）" vertex="1">
          <mxGeometry height="34" width="460" x="1340" y="16" as="geometry" />
        </mxCell>
        <mxCell id="code" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontFamily=Courier New;fillColor=#fafafa;" value="env.setParallelism(2);&lt;br&gt;&lt;br&gt;lines = env.fromData(...)&lt;br&gt;    .name(&quot;source&quot;);&lt;br&gt;&lt;br&gt;counts = lines&lt;br&gt;  .flatMap(...)  .name(&quot;flatmap&quot;)&lt;br&gt;  .keyBy(t -&gt; t.f0)  // 隐式重分区&lt;br&gt;  .sum(1)  .name(&quot;sum&quot;);&lt;br&gt;&lt;br&gt;counts.print()    .name(&quot;sink&quot;);" vertex="1">
          <mxGeometry height="250" width="300" x="30" y="90" as="geometry" />
        </mxCell>
        <mxCell id="c1-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fffbea;strokeColor=#d6b656;" value="肉眼只看到 4 个算子：&lt;br&gt;source / flatmap / sum / sink&lt;br&gt;&lt;br&gt;但 keyBy 与 print 都隐含了&lt;br&gt;额外的算子与分区语义。" vertex="1">
          <mxGeometry height="120" width="300" x="30" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c2-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="1 个算子 = 1 个 StreamNode，保留全部拓扑" vertex="1">
          <mxGeometry height="36" width="300" x="470" y="90" as="geometry" />
        </mxCell>
        <mxCell id="sg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="id=1  Source: source&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;并行度 = 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="260" x="490" y="160" as="geometry" />
        </mxCell>
        <mxCell id="sg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="id=2  flatmap&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;并行度 = 2&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="260" x="490" y="285" as="geometry" />
        </mxCell>
        <mxCell id="sg4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="id=4  sum&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;并行度 = 2&lt;/font&gt;" vertex="1">
