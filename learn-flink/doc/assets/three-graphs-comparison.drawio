          <mxGeometry height="52" width="260" x="490" y="535" as="geometry" />
        </mxCell>
        <mxCell id="sge0" edge="1" parent="1" source="sg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#d79b00;dashed=1;" target="sg2" value="RebalancePartitioner&lt;br&gt;（并行度 1→2）">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sge1" edge="1" parent="1" source="sg2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#d79b00;dashed=1;" target="sg4" value="KeyGroupStreamPartitioner&lt;br&gt;（keyBy 哈希分区）">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sge2" edge="1" parent="1" source="sg4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;strokeColor=#82b366;strokeWidth=2;" target="sg5" value="ForwardPartitioner&lt;br&gt;（✔ 可链）">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c2-note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fffbea;strokeColor=#d6b656;" value="&lt;b&gt;⚠ 节点 id 是 1 / 2 / 4 / 5 —— 3 去哪了？&lt;/b&gt;&lt;br&gt;keyBy 产生的 PartitionTransformation 占用了 id=3，&lt;br&gt;它是一个&lt;b&gt;虚拟节点&lt;/b&gt;（只存分区器属性），&lt;br&gt;不出现在 getStreamNodes() 里。" vertex="1">
