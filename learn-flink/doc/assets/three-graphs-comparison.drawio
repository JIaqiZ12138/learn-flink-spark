        <mxCell id="jg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="Source: source&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;并行度=1  内含算子=1&lt;/font&gt;" vertex="1">
