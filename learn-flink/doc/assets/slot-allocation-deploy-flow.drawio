        <mxCell id="c-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;1&lt;/b&gt;　PipelinedRegionSchedulingStrategy.scheduleRegion()&lt;br&gt;→ SchedulerOperations.allocateSlotsAndDeploy(region 顶点列表)" vertex="1">
