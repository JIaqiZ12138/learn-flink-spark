</mxCell>
        <mxCell id="c-21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;9&lt;/b&gt;　DefaultSlotStatusSyncer.allocateSlot()&lt;br&gt;→ TaskExecutorGateway.requestSlot()&lt;br&gt;&lt;i&gt;【RM → TM】发起方是 RM，不是 JM&lt;/i&gt;" vertex="1">
  <mxGeometry height="84" width="420" x="1060" y="888" as="geometry" />
