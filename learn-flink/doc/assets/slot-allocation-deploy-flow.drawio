        <mxCell id="c-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;2&lt;/b&gt;　DefaultScheduler.allocateSlotsAndDeploy()&lt;br&gt;&lt;b&gt;记录顶点版本号&lt;/b&gt; → 取当前 Execution" vertex="1">
  <mxGeometry height="64" width="420" x="60" y="312" as="geometry" />
