<mxCell id="srcop" value="&lt;b&gt;SourceOperator&lt;OUT, SplitT&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;FLIP-27 拉模式：emitNext -&gt; reader.pollNext&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1018" width="330" height="52" as="geometry" /></mxCell>
<mxCell id="tswm" value="TimestampsAndWatermarksOperator&lt;T&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;水位线 / 时间戳注入 · runtime/operators&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1078" width="330" height="52" as="geometry" /></mxCell>
<mxCell id="swop" value="SinkWriterOperator&lt;InT, CommT&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Sink V2 writer 阶段 · runtime/operators&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1138" width="330" height="52" as="geometry" /></mxCell>
<mxCell id="cmop" value="CommitterOperator&lt;CommT&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;Sink V2 committer 阶段 · runtime/operators&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="1198" width="330" height="52" as="geometry" /></mxCell>
<mxCell id="audf" value="&lt;b&gt;AbstractUdfStreamOperator&lt;OUT, F extends Function&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;抽象：持 userFunction，转发 open/close，注入 RuntimeContext&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="330" height="850" as="geometry" /></mxCell>
<mxCell id="aso" value="&lt;b&gt;AbstractStreamOperator&lt;OUT&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;抽象基类：output / metrics / state / timerService / key 上下文&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="250" height="1110" as="geometry" /></mxCell>
<mxCell id="op" value="&lt;b&gt;StreamOperator&lt;OUT&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;接口：CheckpointListener / KeyContext / Serializable&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="651" width="220" height="88" as="geometry" /></mxCell>
<mxCell id="ewin" value="EvictingWindowOperator&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;extends WindowOperator（配 evictor 时）&lt;br&gt;· runtime/operators&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1440" y="560" width="230" height="52" as="geometry" /></mxCell>
<mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;━━━▷ 实线 + 空心三角 = &lt;b&gt;extends&lt;/b&gt;（继承）&lt;br&gt;╌╌╌▷ 虚线 + 空心三角 = &lt;b&gt;implements&lt;/b&gt;（实现接口）&lt;br&gt;&lt;b&gt;加粗类名&lt;/b&gt; = 重点算子&lt;br&gt;白色方框 = 无颜色填充（默认）&lt;br&gt;&lt;br&gt;父类画成&lt;b&gt;纵向长条（spine）&lt;/b&gt;，覆盖它所有子类的&lt;br&gt;高度；从它出发的每条横线表示「一个子类继承&lt;br&gt;它」—— &lt;b&gt;不是容器包含关系&lt;/b&gt;。这样每条箭头&lt;br&gt;都是独立的水平线，不会互相压在一起。&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="760" height="240" as="geometry" /></mxCell>
<mxCell id="note" value="&lt;b&gt;三个要记住的分叉&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;① &lt;b&gt;AbstractUdfStreamOperator&lt;/b&gt; 是最大分支：&lt;br&gt;　 map/flatMap/filter/process/async/join/&lt;br&gt;　 window/sink 都从它下来，只因它负责&lt;br&gt;　 “把 userFunction 接进运行时”。&lt;br&gt;② &lt;b&gt;SourceOperator&lt;/b&gt; 不走 UDF 分支：&lt;br&gt;　 FLIP-27 拉模式，靠 Enumerator/Reader。&lt;br&gt;③ runtime/operators 里只有&lt;br&gt;　 TimestampsAndWatermarksOperator /&lt;br&gt;　 SinkWriterOperator / CommitterOperator&lt;br&gt;　 是“直接继承 AbstractStreamOperator、&lt;br&gt;　 不包 UDF”的；而 WindowOperator 虽同包，&lt;br&gt;　 却仍 extends AbstractUdfStreamOperator&lt;br&gt;　 （它要持 InternalWindowFunction）。&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="1290" width="830" height="240" as="geometry" /></mxCell>
